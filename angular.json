{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "apps",
  "projects": {
    "acl": {
      "projectType": "library",
      "root": "libs/@amiral-corelab/acl",
      "sourceRoot": "libs/@amiral-corelab/acl/src",
      "prefix": "acl",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/@amiral-corelab/acl/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/@amiral-corelab/acl/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/@amiral-corelab/acl/tsconfig.spec.json",
            "runnerConfig": true
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/@amiral-corelab/acl/**/*.ts", "libs/@amiral-corelab/acl/**/*.html"],
            "eslintConfig": "libs/@amiral-corelab/acl/eslint.config.mjs"
          }
        }
      }
    },
    "shell": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/shell",
      "sourceRoot": "apps/shell/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/shell/src/main.ts",
            "tsConfig": "apps/shell/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/shell/public"
              }
            ],
            "styles": ["apps/shell/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "shell:build:production"
            },
            "development": {
              "buildTarget": "shell:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/shell/**/*.ts", "apps/shell/**/*.html"],
            "eslintConfig": "apps/shell/eslint.config.js"
          }
        }
      }
    },
    "@amiral-corelab/svg": {
      "projectType": "library",
      "root": "libs/@amiral-corelab/svg",
      "sourceRoot": "libs/@amiral-corelab/svg/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/@amiral-corelab/svg/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/@amiral-corelab/svg/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/@amiral-corelab/svg/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/@amiral-corelab/svg/**/*.ts", "libs/@amiral-corelab/svg/**/*.html"],
            "eslintConfig": "libs/@amiral-corelab/svg/eslint.config.mjs"
          }
        }
      }
    },
    "@amiral-corelab/core": {
      "projectType": "library",
      "root": "libs/@amiral-corelab/core",
      "sourceRoot": "libs/@amiral-corelab/core/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/@amiral-corelab/core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/@amiral-corelab/core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/@amiral-corelab/core/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/@amiral-corelab/core/**/*.ts", "libs/@amiral-corelab/core/**/*.html"],
            "eslintConfig": "libs/@amiral-corelab/core/eslint.config.mjs"
          }
        }
      }
    },
    "symbol-editor": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/symbol-editor",
      "sourceRoot": "apps/symbol-editor/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/symbol-editor/src/main.ts",
            "tsConfig": "apps/symbol-editor/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/symbol-editor/public"
              }
            ],
            "styles": ["apps/symbol-editor/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "symbol-editor:build:production"
            },
            "development": {
              "buildTarget": "symbol-editor:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/symbol-editor/**/*.ts", "apps/symbol-editor/**/*.html"],
            "eslintConfig": "apps/symbol-editor/eslint.config.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:application": {
      "inlineStyle": false,
      "inlineTemplate": false,
      "minimal": true,
      "ssr": false,
      "standalone": true,
      "style": "scss",
      "zoneless": true,
      "strict": true,
      "routing": true
    },
    "@schematics/angular:class": {
      "type": ""
    },
    "@schematics/angular:component": {
      "type": "component",
      "style": "scss",
      "standalone": true,
      "inlineTemplate": false,
      "inlineStyle": false,
      "changeDetection": "OnPush",
      "displayBlock": true
    },
    "@schematics/angular:directive": {
      "standalone": true,
      "type": "directive"
    },
    "@schematics/angular:enum": {
      "type": "enum"
    },
    "@schematics/angular:guard": {
      "flat": true,
      "functional": true,
      "implements": ["CanActivate"],
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": ".",
      "functional": true
    },
    "@schematics/angular:interface": {
      "type": "model"
    },
    "@schematics/angular:library": {
      "standalone": true,
      "entryFile": "index",
      "prefix": "acl"
    },
    "@schematics/angular:pipe": {
      "standalone": true,
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "functional": true,
      "typeSeparator": "."
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:web-worker": {
      "snippet": true
    }
  }
}
