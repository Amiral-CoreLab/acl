{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "apps",
  "projects": {
    "acl": {
      "projectType": "library",
      "root": "libs/@amiral-corelab/acl",
      "sourceRoot": "libs/@amiral-corelab/acl/src",
      "prefix": "acl",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/@amiral-corelab/acl/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/@amiral-corelab/acl/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/@amiral-corelab/acl/tsconfig.spec.json",
            "runnerConfig": true
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/@amiral-corelab/acl/**/*.ts", "libs/@amiral-corelab/acl/**/*.html"],
            "eslintConfig": "libs/@amiral-corelab/acl/eslint.config.mjs"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:application": {
      "inlineStyle": false,
      "inlineTemplate": false,
      "minimal": true,
      "ssr": false,
      "standalone": true,
      "style": "scss",
      "zoneless": true,
      "strict": true,
      "routing": true
    },
    "@schematics/angular:class": {
      "type": ""
    },
    "@schematics/angular:component": {
      "type": "component",
      "style": "scss",
      "standalone": true,
      "inlineTemplate": false,
      "inlineStyle": false,
      "changeDetection": "OnPush",
      "displayBlock": true
    },
    "@schematics/angular:directive": {
      "standalone": true,
      "type": "directive"
    },
    "@schematics/angular:enum": {
      "type": "enum"
    },
    "@schematics/angular:guard": {
      "flat": true,
      "functional": true,
      "implements": ["CanActivate"],
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": ".",
      "functional": true
    },
    "@schematics/angular:interface": {
      "type": "model"
    },
    "@schematics/angular:library": {
      "standalone": true,
      "entryFile": "index",
      "prefix": "acl"
    },
    "@schematics/angular:pipe": {
      "standalone": true,
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "functional": true,
      "typeSeparator": "."
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:web-worker": {
      "snippet": true
    }
  }
}
