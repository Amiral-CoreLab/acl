{
  "name": "@amiral-corelab/acl",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "acl:build": "ng run acl:build",
    "acl:storybook": "ng run acl:storybook",
    "acl:storybook-host": "ng run acl:storybook --host=0.0.0.0",
    "acl:storybook-build": "ng run acl:build-storybook",
    "acl:test": "ng run acl:test --watch=false --coverage",
    "acl:lint": "ng run acl:lint",
    "acl:lint-styles": "stylelint libs/@amiral-corelab/acl/**/*.scss",
    "tools:harmonizer": "tsx tools/color/harmonizer/harmonizer.ts",
    "tools:svgo": "npx svgo -f generated/icons -r --config=tools/svgo/svgo.config.ts && tsx tools/svgo/svg-to-scss.ts",
    "tools:figma-icon": "tsx tools/figma/figma-icon.ts && npm run tools:svgo",
    "tools:figma-color": "tsx tools/figma/figma-color.ts",
    "tools:figma-component": "tsx tools/figma/figma-component.ts",
    "tools:figma-spec": "tsx tools/figma/figma-spec.ts",
    "ci:rerun": "tsx tools/github/wait-ci-rerun.ts",
    "ci:wait-on": "tsx tools/github/wait-on.ts",
    "ci:check": "npm run tools:figma-icon && npm run tools:figma-color && npm run tools:figma-component && npm run tools:figma-spec && npm run acl:build && npm run acl:storybook-build && npm run acl:test && npm run acl:lint && npm run acl:lint-styles"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.0.3",
    "@angular/compiler": "21.0.3",
    "@angular/core": "21.0.3",
    "@angular/forms": "21.0.3",
    "@angular/platform-browser": "21.0.3",
    "@angular/platform-browser-dynamic": "21.0.3",
    "@angular/router": "21.0.3",
    "@ibm/plex-sans": "1.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.0.2",
    "@angular/build": "21.0.2",
    "@angular/cli": "21.0.2",
    "@angular/compiler-cli": "21.0.3",
    "@eslint/js": "9.39.1",
    "@figma/rest-api-spec": "0.34.0",
    "@storybook/addon-docs": "10.1.4",
    "@storybook/angular": "10.1.4",
    "@types/culori": "4.0.1",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "4.0.15",
    "angular-eslint": "21.0.1",
    "apcach": "0.6.4",
    "chalk": "5.6.2",
    "culori": "4.0.2",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-storybook": "10.1.4",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "ng-packagr": "21.0.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.57.0",
    "pngjs": "7.0.0",
    "prettier": "3.7.4",
    "storybook": "10.1.4",
    "stylelint": "16.26.1",
    "stylelint-config-recess-order": "7.4.0",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-order": "7.0.0",
    "stylelint-prettier": "5.0.3",
    "svgo": "4.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.0.15"
  }
}
