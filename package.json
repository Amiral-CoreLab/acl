{
  "name": "@amiral-corelab/acl",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "acl:run": "ng run acl:storybook --host=0.0.0.0",
    "acl:lint": "ng run acl:lint && stylelint libs/@amiral-corelab/acl/**/*.scss",
    "acl:test": "ng run acl:test",
    "acl:figma-fetch": "tsx tools/figma/icons && tsx tools/figma/typos && tsx tools/figma/colors && tsx tools/figma/components && tsx tools/figma/specs",
    "acl:figma-setup": "svgo -f artifacts/figma/icons -r --config=tools/artifact-figma/svgo.config.ts && tsx tools/artifact-figma/icons && tsx tools/artifact-figma/typos && tsx tools/artifact-figma/colors && tsx tools/artifact-figma/components && tsx tools/artifact-figma/specs",
    "acl:figma": "npm run acl:figma-fetch && npm run acl:figma-setup",
    "acl:visual-regression": "npm run acl:figma && tsx tools/visual-regression/test && tsx tools/artifact-visual-regression/images && tsx tools/artifact-visual-regression/markdown"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.0.6",
    "@angular/compiler": "21.0.6",
    "@angular/core": "21.0.6",
    "@angular/forms": "21.0.6",
    "@angular/platform-browser": "21.0.6",
    "@angular/platform-browser-dynamic": "21.0.6",
    "@angular/router": "21.0.6",
    "@ibm/plex-sans": "1.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.0.4",
    "@angular/build": "21.0.4",
    "@angular/cli": "21.0.4",
    "@angular/compiler-cli": "21.0.6",
    "@compodoc/compodoc": "1.1.32",
    "@eslint/js": "9.39.2",
    "@figma/rest-api-spec": "0.35.0",
    "@storybook/addon-docs": "10.1.10",
    "@storybook/angular": "10.1.10",
    "@types/culori": "4.0.1",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "4.0.16",
    "angular-eslint": "21.1.0",
    "apcach": "0.6.4",
    "chalk": "5.6.2",
    "culori": "4.0.2",
    "dotenv": "17.2.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-storybook": "10.1.10",
    "globals": "16.5.0",
    "jsdom": "27.3.0",
    "ng-packagr": "21.0.1",
    "pixelmatch": "7.1.0",
    "playwright": "1.57.0",
    "pngjs": "7.0.0",
    "prettier": "3.7.4",
    "storybook": "10.1.10",
    "stylelint": "16.26.1",
    "stylelint-config-recess-order": "7.4.0",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-order": "7.0.0",
    "stylelint-prettier": "5.0.3",
    "svgo": "4.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vitest": "4.0.16"
  }
}
