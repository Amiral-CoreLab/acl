            "sourceCode": "import { ChangeDetectionStrategy, Component, computed, input, ViewEncapsulation } from '@angular/core';\nimport type { IconType } from './icon.type';\n\n@Component({\n  selector: 'acl-icon',\n  imports: [],\n  templateUrl: './icon.component.html',\n  styleUrl: './icon.component.scss',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  encapsulation: ViewEncapsulation.None,\n  host: {\n    '[style.mask-image]': `iconVar()`,\n  },\n})\nexport class IconComponent {\n  public readonly name = input.required<IconType>();\n\n  /** @ignore */\n  protected readonly iconVar = computed((): string => `var(--acl-icon-${this.name()})`);\n}\n",
